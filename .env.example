# Copia este fichero como .env (en la misma carpeta) para trabajar en tu ordenador.
# En el servidor estas variables se ponen en el panel del proveedor (Render, etc.).

# --- Imprescindibles ---------------------------------------------------------
# true en tu ordenador; en el servidor, false (o no la pongas).
DEBUG=true
# En producción, una cadena larga y secreta. En local puede quedarse vacía.
SECRET_KEY=
# Dominios desde los que se sirve la web, separados por comas (producción).
# ALLOWED_HOSTS=midominio.com,www.midominio.com
# CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com

# --- Base de datos ----------------------------------------------------------
# Sin esta variable se usa SQLite (db.sqlite3), perfecto para local.
# DATABASE_URL=postgres://usuario:clave@host:5432/dragonboat

# --- Comunidad ---------------------------------------------------------------
# true = lo que publican los usuarios espera a que un administrador lo apruebe.
COMMUNITY_REQUIRES_APPROVAL=false
# Máximo de noticias + eventos que cada usuario puede publicar en 24 horas.
COMMUNITY_DAILY_LIMIT=10

# --- Noticias automáticas ----------------------------------------------------
# Clave para publicar noticias por la API (tarea programada, GitHub Actions...).
# Vacía = API desactivada. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEWS_API_TOKEN=

# --- Nombre de la web --------------------------------------------------------
# SITE_NAME=Dragon Boat
# SITE_TAGLINE=Noticias, regatas y comunidad del dragon boat y el remo

# --- Email (recuperar contraseña) -------------------------------------------
# Sin EMAIL_HOST, los emails se muestran en la consola en vez de enviarse.
# EMAIL_HOST=smtp.ejemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=Dragon Boat <no-responder@midominio.com>

# --- Imágenes subidas ---------------------------------------------------------
# Tamaño máximo de cada imagen, en MB.
# MAX_UPLOAD_MB=5
# Con un disco persistente en el servidor:
# MEDIA_ROOT=/var/data/media
# SERVE_MEDIA=true
# O con almacenamiento S3/R2/B2 (requiere: pip install "django-storages[s3]"):
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
